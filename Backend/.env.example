# Example environment variables for the Refactored Backend
# -------------------------------------------------------
# Database URL – AsyncPG format
# e.g. postgresql+asyncpg://user:password@localhost:5432/nex_talk
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/nex_talk

# JWT secrets (generate strong random strings)
JWT_SECRET_KEY=super-secret-key-change-me
JWT_REFRESH_SECRET=super-refresh-secret-change-me
JWT_RESET_SECRET=super-reset-secret-change-me

# Token expirations (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=43200  # 30 days
RESET_TOKEN_EXPIRE_MINUTES=60

# Email (SMTP) – configure for development or use a testing service
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@nex-talk.local

# CORS – origins allowed to hit the API (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Misc
DEBUG=True
