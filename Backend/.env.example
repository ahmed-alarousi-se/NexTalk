# Example environment variables for the NexTalk Backend
# -------------------------------------------------------
# Local dev:  cp .env.example .env   (use localhost for DATABASE_URL)
# Docker:     use root .env — compose sets DATABASE_URL automatically

# Database URL — local AsyncPG format, or paste your host's postgres:// URL as-is
# Local:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nex_talk
# Docker (set automatically by docker-compose — do not override in root .env):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/nex_talk
# Railway / Render / Supabase (required in production — postgres:// is auto-converted):
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-firebase-project-id
# Full service account JSON on one line (Firebase Console → Service accounts → Generate new private key)
FIREBASE_CREDENTIALS_JSON=

# Frontend URL (used for CORS context)
FRONTEND_URL=http://localhost:5173

# CORS – origins allowed to hit the API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080
# Allow any localhost port in dev (5173, 8080, etc.) — set false in production
CORS_ALLOW_LOCALHOST=true

# Rate limiting
MESSAGE_RATE_LIMIT_PER_MINUTE=60
