# Repo root context for Backend/Dockerfile and Frontend/Dockerfile
.git
.gitignore

# Backend
Backend/.venv
Backend/**/__pycache__
Backend/**/*.py[cod]
Backend/.pytest_cache
Backend/.mypy_cache
Backend/.ruff_cache
Backend/.env
Backend/.env.*
!Backend/.env.example
Backend/static/uploads/*
!Backend/static/uploads/.gitkeep
*firebase*adminsdk*.json
firebase-credentials.json

# Frontend
Frontend/node_modules
Frontend/dist
Frontend/.output
Frontend/.vinxi
Frontend/.tanstack
Frontend/.nitro
Frontend/.env
Frontend/.env.*
!Frontend/.env.example
Frontend/*.log
Frontend/npm-debug.log*
